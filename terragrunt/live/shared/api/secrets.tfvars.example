# Copy this file to secrets.tfvars (git-ignored — never commit the real values) and fill in
# the real SMTP credentials before running `terragrunt apply`. Left unset, SMTP_USERNAME and
# SMTP_PASSWORD are stored as empty strings and email sending won't work until this is set
# and the unit is re-applied. For Gmail, smtp_password must be an app password, not the
# account password, and smtp_username must match the EMAIL_FROM mailbox in terragrunt.hcl.

smtp_username = "changeme@gmail.com"
smtp_password = "xxxx xxxx xxxx xxxx"
